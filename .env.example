# Port for local Express server (default: 4000)
PORT=4000

# MongoDB Atlas connection string with campustrack database
# Replace <username> and <password> with your Atlas database credentials.
# Remember to percent-encode any special characters in your password.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/campustrack?retryWrites=true&w=majority
