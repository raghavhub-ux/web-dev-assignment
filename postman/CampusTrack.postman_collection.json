            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/assignments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "assignments"]
            },
            "description": "Get all assignments for logged-in user, sorted by ascending due date (max 100)."
          },
          "response": []
        },
        {
          "name": "3. List Assignments (With Filters)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
